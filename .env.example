# --- Bayse Markets (only needed for live trading / account commands; market data is public) ---
BAYSE_PUBLIC_KEY=your_bayse_public_key_here
BAYSE_SECRET_KEY=your_bayse_secret_key_here
BAYSE_API_URL=https://relay.bayse.markets
BAYSE_USER_ID=your_bayse_user_id_here
BAYSE_EMAIL=you@example.com

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Optional research / LLM blend (the SLM works without these) ---
TAVILY_API_KEY=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
LLM_BLEND_WEIGHT=0.25

# --- Agent ---
DRY_RUN=true                 # keep true unless you accept the risk of real orders
BANKROLL=100.0
CURRENCY=USD
MIN_EDGE=0.08                # post-fee edge; values below 0.08 are raised to 0.08
KELLY_FRACTION=0.25          # clamped to 0.25-0.5 (quarter to half Kelly)
MAX_POSITION_FRACTION=0.05   # hard cap per trade (max 0.05)
MAX_DAILY_LOSS_FRACTION=0.10 # daily worst-case risk budget (new stakes - realized PnL) as a fraction of bankroll
MAX_OPEN_POSITIONS=10
MAX_TRADES_PER_CYCLE=3
MIN_ORDERS=10
MIN_LIQUIDITY=0
MIN_HOURS_TO_CLOSE=6
MAX_DAYS_TO_CLOSE=7          # the SLM was trained on markets <= ~7 days from close
SCAN_PAGES=3                 # pages of 20 events per category
SCAN_CATEGORIES=politics,sports,entertainment,economy,culture
CYCLE_INTERVAL_SECONDS=300
DATABASE_PATH=data/medes.db
LOG_LEVEL=INFO
# SLM_ARTIFACT_PATH=medes_et_bayse/slm/artifacts/bayse_slm.json
# SLM_DISABLE_TEXT=false
