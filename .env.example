# Bayse Markets credentials
BAYSE_PUBLIC_KEY=your_bayse_public_key_here
BAYSE_SECRET_KEY=your_bayse_secret_key_here
BAYSE_API_URL=https://relay.bayse.markets

# Tavily Search API (for market research)
TAVILY_API_KEY=your_tavily_api_key_here

# Telegram bot integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=6433282551

# SQLite database path (Render persistent disk mount)
DATABASE_PATH=/data/medes.db

# Bot configuration
DRY_RUN=true
BANKROLL=100.0
MAX_POSITION_FRACTION=0.05
MIN_EDGE=0.03
CYCLE_INTERVAL_SECONDS=300
LOG_LEVEL=INFO

# Trading currency
CURRENCY=USD
